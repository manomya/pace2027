    "gsap": "^3.15.0",
    "ponytail": "^1.0.57"
  },
  "devDependencies": {
    "agentation": "^3.1.2",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
