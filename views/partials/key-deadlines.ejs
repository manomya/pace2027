<style>
.deadlines {
  --ivory: #fbf3e3;
  --burgundy: #651a29;
  --burgundy-dark: #4b111d;
  --gold: #c49a2c;
  --gold-light: #dfc27b;
  --ink: #4b3b34;
  --muted: #85766a;
  --line: rgba(196, 154, 44, .42);
  position: relative;
  isolation: isolate;
  overflow: hidden;
  min-height: 100vh;
  background: var(--ivory);
  color: var(--ink);
  font-family: 'DM Sans', sans-serif;
  padding: 70px clamp(24px, 5vw, 86px) 76px;
  box-sizing: border-box;
}
.deadlines * {
  box-sizing: border-box;
}
.deadlines:before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -2;
  opacity: .34;
  background-image: linear-gradient(rgba(196, 154, 44, .12) 1px, transparent 1px), linear-gradient(90deg, rgba(196, 154, 44, .12) 1px, transparent 1px);
  background-size: 38px 38px;
  mask-image: linear-gradient(90deg, #000, transparent 80%);
  -webkit-mask-image: linear-gradient(90deg, #000, transparent 80%);
}
.deadlines:after {
  content: "";
  position: absolute;
  z-index: -2;
  left: 0;
  top: 0;
  bottom: 0;
  width: clamp(170px, 16vw, 260px);
  background: var(--burgundy);
}
.deadlines .blueprint {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: clamp(170px, 16vw, 260px);
  opacity: 1;
  pointer-events: none;
  background-image: url("/images/pillar-about.png?v=2027.1");
  background-size: 100% 100%;
  background-position: center;
  background-repeat: no-repeat;
  z-index: -1;
}
.deadlines .blueprint svg {
  display: none;
}
.deadlines .deadlines-inner {
  max-width: 1450px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(110px, 22%) minmax(0, 1fr);
  gap: clamp(30px, 4vw, 70px);
  position: relative;
}
.deadlines .deadlines-content {
  grid-column: 2;
  min-width: 0;
}
.deadlines .ornament {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 13px;
  margin: 0 auto 26px;
  max-width: 560px;
  color: var(--gold);
}
.deadlines .ornament:before,
.deadlines .ornament:after {
  content: "";
  height: 1px;
  background: var(--line);
  flex: 1;
}
.deadlines .ornament span {
  font-size: 14px;
  letter-spacing: 7px;
}
.deadlines .eyebrow {
  margin: 0 0 8px;
  color: var(--gold);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .34em;
  text-transform: uppercase;
  font-family: 'DM Sans', sans-serif;
}
.deadlines .eyebrow::before {
  content: none !important;
}
.deadlines h1 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(48px, 5.8vw, 86px);
  font-weight: 600;
  line-height: .91;
  letter-spacing: -.035em;
  margin: 0;
  color: var(--burgundy);
}
.deadlines h1 em {
  font-style: normal;
  color: var(--gold);
}
.deadlines .intro {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(17px, 1.35vw, 21px);
  line-height: 1.35;
  max-width: 720px;
  color: #76695f;
  margin: 16px 0 28px;
}
.deadlines .timeline {
  position: relative;
  margin: 0 0 24px;
  padding: 0;
  list-style: none;
}
.deadlines .timeline:before {
  content: "";
  position: absolute;
  left: 21px;
  top: 25px;
  bottom: 25px;
  width: 1px;
  background: var(--gold-light);
}
.deadlines .deadline {
  display: grid;
  grid-template-columns: 48px minmax(0, 1fr) minmax(150px, 225px);
  align-items: center;
  gap: 18px;
  min-height: 72px;
  padding: 9px 0;
  border-top: 1px solid var(--line);
  position: relative;
  transition: transform .25s ease, background .25s ease;
}
.deadlines .deadline:last-child {
  border-bottom: 1px solid var(--line);
}
.deadlines .deadline:hover {
  transform: translateX(5px);
  background: rgba(255, 255, 255, .28);
}
.deadlines .date-icon {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--burgundy);
  border: 1px solid var(--gold);
  color: var(--gold-light);
  position: relative;
  z-index: 1;
  box-shadow: 0 0 0 5px var(--ivory);
}
.deadlines .date-icon svg {
  width: 21px;
  height: 21px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.deadlines .deadline-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(20px, 1.7vw, 27px);
  font-weight: 700;
  color: var(--burgundy);
  line-height: 1.05;
}
.deadlines .deadline-desc {
  font-family: 'Cormorant Garamond', serif;
  font-size: 17px;
  color: var(--muted);
  margin-top: 4px;
}
.deadlines .date {
  justify-self: stretch;
  align-self: stretch;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 8px 20px 8px 28px;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, .2);
  font-family: 'Cormorant Garamond', serif;
  font-weight: 700;
  font-size: clamp(19px, 1.65vw, 25px);
  color: var(--burgundy);
  position: relative;
  clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 0 100%);
}
.deadlines .date:after {
  content: "";
  width: 28px;
  height: 2px;
  background: var(--gold);
  margin-top: 7px;
}
.deadlines .deadline:last-child .date {
  color: #a8790b;
}
.deadlines .cta {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  padding: 16px 24px;
  background: var(--gold);
  color: var(--burgundy-dark);
  font-size: 13px;
  letter-spacing: .06em;
  text-decoration: none;
  border: 1px solid var(--gold);
  transition: background .2s, transform .2s;
  font-family: 'DM Sans', sans-serif;
}
.deadlines .cta:hover {
  background: #d8b54f;
  transform: translateY(-2px);
}
.deadlines .cta span {
  font-size: 19px;
}
@media (max-width: 900px) {
  .deadlines { padding: 48px 24px 56px; }
  .deadlines:after, .deadlines .blueprint { width: clamp(76px, 12vw, 120px); }
  .deadlines .deadlines-inner { grid-template-columns: 55px minmax(0, 1fr); gap: 20px; }
  .deadlines .deadline { grid-template-columns: 43px minmax(0, 1fr); gap: 14px; padding: 14px 0; }
  .deadlines .date { grid-column: 2; min-height: auto; padding: 8px 12px; clip-path: none; font-size: 20px; }
  .deadlines .date:after { margin-top: 4px; }
  .deadlines .deadline-title { font-size: 23px; }
  .deadlines .deadline-desc { font-size: 16px; }
  .deadlines .intro { margin-bottom: 24px; }
}
@media (max-width: 520px) {
  .deadlines { padding: 38px 17px 44px; }
  .deadlines:after, .deadlines .blueprint { width: 22px; }
  .deadlines .deadlines-inner { display: block; }
  .deadlines .deadlines-content { padding-left: 12px; }
  .deadlines .ornament { margin-bottom: 22px; }
  .deadlines .ornament span { letter-spacing: 4px; }
  .deadlines h1 { font-size: 49px; }
  .deadlines .intro { font-size: 18px; }
  .deadlines .timeline:before { left: 17px; }
  .deadlines .deadline { grid-template-columns: 36px minmax(0, 1fr); gap: 11px; min-height: 0; padding: 13px 0; }
  .deadlines .date-icon { width: 35px; height: 35px; }
  .deadlines .date-icon svg { width: 18px; height: 18px; }
  .deadlines .deadline-title { font-size: 21px; }
  .deadlines .deadline-desc { font-size: 15px; }
  .deadlines .date { font-size: 19px; }
  .deadlines .cta { padding: 14px 17px; }
}
@media (prefers-reduced-motion: reduce) {
  .deadlines, .deadlines:before, .deadlines:after, .deadlines * { scroll-behavior: auto !important; transition: none !important; }
}
</style>

