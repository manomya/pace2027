<style id="brick-wall-critical-styles">
  .brick-reveal-container {
    position: relative;
    width: 100%;
  }
  .brick-stage-wrapper {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    perspective: 1400px;
    perspective-origin: 50% 45%;
  }
  .brick-stage {
    position: relative;
    width: 100%;
    min-height: 520px;
    border-radius: 4px;
    transform-style: preserve-3d;
  }

  /* Layer 1: Real Sponsor Content Behind Wall — Centered & Symmetrical */
  .brick-sponsor-backdrop {
    position: relative;
    width: 100%;
    min-height: 520px;
    padding: 44px clamp(20px, 4vw, 56px) 52px;
    background: #FFFFFF;
    border: 2px solid var(--line, #DCC998);
    border-top: 4px solid var(--maroon, #5E0F1E);
    box-shadow: 0 12px 36px rgba(94, 15, 30, 0.08);
    border-radius: 4px;
    z-index: 5;
    transform-origin: 50% 50%;
    transform: translateZ(0px);
    will-change: filter, transform;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .brick-sponsor-intro {
    text-align: center;
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line, #DCC998);
    width: 100%;
    max-width: 820px;
  }
  .sponsor-kicker {
    display: block;
    font-family: var(--label, 'Marcellus', serif);
    font-size: 12px;
    letter-spacing: 2.5px;
    color: var(--gold-dk, #A47F14);
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .sponsor-headline {
    font-family: var(--disp, 'Cormorant Garamond', serif);
    font-size: clamp(24px, 2.4vw, 32px);
    color: var(--maroon, #5E0F1E);
    margin: 0;
    font-weight: 600;
    line-height: 1.25;
  }

  /* Partner Columns Grid Layout inside Backdrop */
  .brick-sponsor-backdrop .pgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(18px, 2.5vw, 36px);
    width: 100%;
    max-width: 1360px;
    margin: 0 auto;
    align-items: stretch;
  }
  .brick-sponsor-backdrop .pgrid > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: #FAF8F5;
    border: 1px solid var(--line, #DCC998);
    border-top: 3px solid var(--maroon, #5E0F1E);
    border-radius: 4px;
    padding: 24px 20px 26px;
    box-sizing: border-box;
    box-shadow: 0 4px 14px rgba(94, 15, 30, 0.04);
  }
  .brick-sponsor-backdrop .pgrid h4 {
    font-family: var(--label, 'Marcellus', serif);
    font-size: 13.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--maroon, #5E0F1E);
    margin: 0 0 18px 0;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line, #DCC998);
    width: 100%;
    text-align: center;
    font-weight: 600;
  }
  .brick-sponsor-backdrop .logos {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-top: 0;
    flex: 1;
  }
  .brick-sponsor-backdrop .logo {
    background: #FFFFFF;
    border: 1px solid var(--line, #DCC998);
    border-bottom: 3px solid var(--gold, #C9A227);
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 98px;
    width: 100%;
    max-width: 260px;
    border-radius: 4px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    box-sizing: border-box;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .brick-sponsor-backdrop .logo:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(94, 15, 30, 0.12);
    border-color: var(--gold, #C9A227);
  }
  .brick-sponsor-backdrop .logo img {
    max-height: 58px;
    max-width: 195px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  /* Layer 2: Deconstructible Brick Wall Matrix */
  .brick-wall-matrix {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 30;
    display: flex;
    flex-direction: column;
    padding: 4px;
    border: 3px solid var(--maroon, #5E0F1E);
    outline: 2px solid var(--gold, #C9A227);
    outline-offset: 3px;
    background: transparent;
    box-shadow: inset 0 0 25px rgba(60, 35, 20, 0.25), 0 16px 45px rgba(0, 0, 0, 0.22);
    transform-style: preserve-3d;
    transform: translateZ(20px);
    pointer-events: none;
    border-radius: 4px;
    overflow: visible;
    box-sizing: border-box;
  }
  .brick-row {
    display: flex;
    flex: 1 1 0;
    min-height: 38px;
    width: 100%;
    transform-style: preserve-3d;
  }
  .brick {
    position: relative;
    flex: 1 1 0;
    height: 100%;
    min-height: 36px;
    margin: 2px;
    border-radius: 2px;
    transform-style: preserve-3d;
    backface-visibility: hidden;
    will-change: transform, opacity;
    outline: 2px solid #CFC0A8;
    box-shadow: 
      inset 1px 1px 0.5px rgba(255, 255, 255, 0.35),
      inset -1px -1px 1px rgba(0, 0, 0, 0.5),
      0 2px 5px rgba(0, 0, 0, 0.3);
    cursor: default;
    box-sizing: border-box;
    display: block;
  }
  .brick.half-brick {
    flex: 0.5 1 0;
  }
  .brick::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0%, transparent 45%, rgba(0, 0, 0, 0.28) 100%);
    mix-blend-mode: overlay;
    pointer-events: none;
  }
  .brick::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(90deg, transparent 0, transparent 4px, rgba(0, 0, 0, 0.04) 5px);
    opacity: 0.75;
    pointer-events: none;
  }

  /* Layer 3: Mortar Dust Canvas */
  .brick-dust-canvas {
    position: absolute;
    inset: -30px;
    width: calc(100% + 60px);
    height: calc(100% + 60px);
    pointer-events: none;
    z-index: 35;
  }

  /* Layer 4: Foundation Plinth */
  .brick-wall-plinth {
    position: absolute;
    left: -2px;
    right: -2px;
    bottom: -20px;
    z-index: 32;
    height: 22px;
    background: #46111C;
    border-top: 2px solid var(--gold, #C9A227);
    border-bottom: 2px solid var(--gold-dk, #A47F14);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .plinth-engraving {
    font-family: var(--label, 'Marcellus', serif);
    font-size: 10.5px;
    letter-spacing: 2px;
    color: var(--gold-lt, #E5C76B);
    text-transform: uppercase;
  }

  /* Responsive Rules */
  @media (max-width: 980px) {
    .brick-stage { min-height: 580px; }
    .brick-sponsor-backdrop { min-height: 580px; padding: 32px 20px 44px; }
    .brick-sponsor-backdrop .pgrid {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 20px;
    }
    .plinth-engraving { font-size: 9px; letter-spacing: 1.2px; }
  }
  @media (max-width: 680px) {
    .brick-stage { min-height: 640px; }
    .brick-sponsor-backdrop { min-height: 640px; padding: 24px 14px 36px; }
    .brick-sponsor-backdrop .pgrid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  /* Layer 2.5: Architectural Cornerstone Plaque on Brick Wall */
  .brick-wall-plaque {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) translateZ(40px);
    z-index: 35;
    pointer-events: none;
    background: rgba(46, 12, 18, 0.94);
    border: 2px solid var(--gold, #C9A227);
    outline: 1px solid rgba(229, 199, 107, 0.4);
    outline-offset: 4px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    border-radius: 4px;
    padding: 24px 36px;
    text-align: center;
    max-width: 90%;
    width: 480px;
  }
  .plaque-kicker {
    display: block;
    font-family: var(--label, 'Marcellus', serif);
    font-size: 11px;
    letter-spacing: 3px;
    color: var(--gold-lt, #E5C76B);
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .plaque-heading {
    font-family: var(--disp, 'Cormorant Garamond', serif);
    font-size: clamp(28px, 3.2vw, 42px);
    color: #FFFFFF;
    margin: 0;
    font-weight: 700;
    line-height: 1.15;
  }
  .plaque-divider {
    width: 60px;
    height: 2px;
    background: var(--gold, #C9A227);
    margin: 10px auto;
  }
  .plaque-scroll-hint {
    display: block;
    font-family: var(--label, 'Marcellus', serif);
    font-size: 12px;
    letter-spacing: 1.5px;
    color: #D9BFA0;
    text-transform: uppercase;
  }
</style>

<div class="brick-reveal-container" id="brick-partners-reveal">
  <!-- Pinned Stage Wrapper -->
  <div class="brick-stage-wrapper">

    <div class="brick-stage" id="brick-stage">
      <!-- Layer 1: Real Sponsor Content (Behind the Wall) -->
      <div class="brick-sponsor-backdrop" id="brick-sponsor-backdrop">
        <div class="brick-sponsor-intro">
          <div class="eyebrow" style="margin-bottom:6px;">Our Partners</div>
          <h2 style="font-family:var(--disp,'Cormorant Garamond',serif);font-size:clamp(30px,3.2vw,44px);color:var(--maroon,#5E0F1E);margin:0 0 14px;font-weight:700;">Conference Partners</h2>
          <span class="sponsor-kicker">PACE–2027 Collaborative Network</span>
          <h3 class="sponsor-headline">Our Industry &amp; Institutional Partners</h3>
        </div>
        <%- include('partners') %>
      </div>

      <!-- Layer 2: Realistic Deconstructible Brick Wall Matrix -->
      <div class="brick-wall-matrix" id="brick-wall-matrix" aria-hidden="true">
        <!-- Populated programmatically with individual rectangular staggered bricks -->
      </div>

      <!-- Layer 2.5: Architectural Cornerstone Plaque on Closed Brick Wall -->
      <div class="brick-wall-plaque" id="brick-wall-plaque" aria-hidden="true">
        <span class="plaque-kicker">PACE–2027 · FOUNDATION MATRIX</span>
        <h2 class="plaque-heading">Conference Partners</h2>
        <div class="plaque-divider"></div>
        <span class="plaque-scroll-hint">Scroll down to deconstruct &amp; reveal partners</span>
      </div>

      <!-- Layer 3: Performance Mortar Dust Particle Canvas -->
      <canvas class="brick-dust-canvas" id="brick-dust-canvas" aria-hidden="true"></canvas>

      <!-- Layer 4: Architectural Plinth / Foundation Stone -->
      <div class="brick-wall-plinth" aria-hidden="true">
        <span class="plinth-engraving">PACE–2027 · CIVIL ENGINEERING FOUNDATIONS · POORNIMA UNIVERSITY</span>
      </div>
    </div>

  </div>
</div>
