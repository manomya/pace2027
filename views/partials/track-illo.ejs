<%#
  PACE-2027 | Track Engineering Illustration Partial
  Renders bespoke SVG engineering linework for each of the six tracks.
  Pure vector drafting illustrations with consistent architectural line weights.
  Variables: illoId (string), accent (hex color string)
%>

<% if (illoId === 'illo-structural') { %>
<%# ── Track 01 · Structural Engineering & Smart Infrastructure ── %>
<svg class="atlas-illo-svg" viewBox="0 0 280 120" xmlns="http://www.w3.org/2000/svg"
     role="img" aria-label="Structural frame and truss engineering blueprint">
  <defs>
    <pattern id="hatch-str" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="6" stroke="<%= accent %>" stroke-width="0.75" opacity="0.35"/>
    </pattern>
  </defs>
  <!-- Foundation Footing & Soil Baseline -->
  <line class="illo-line" x1="12" y1="108" x2="268" y2="108" stroke="<%= accent %>" stroke-width="1.6"/>
  <rect class="illo-path" x="20" y="100" width="36" height="8" fill="url(#hatch-str)" stroke="<%= accent %>" stroke-width="1"/>
  <rect class="illo-path" x="122" y="100" width="36" height="8" fill="url(#hatch-str)" stroke="<%= accent %>" stroke-width="1"/>
  <rect class="illo-path" x="224" y="100" width="36" height="8" fill="url(#hatch-str)" stroke="<%= accent %>" stroke-width="1"/>

  <!-- Vertical Structural Columns -->
  <line class="illo-line" x1="38" y1="22" x2="38" y2="100" stroke="<%= accent %>" stroke-width="2.2"/>
  <line class="illo-line" x1="140" y1="22" x2="140" y2="100" stroke="<%= accent %>" stroke-width="2.2"/>
  <line class="illo-line" x1="242" y1="22" x2="242" y2="100" stroke="<%= accent %>" stroke-width="2.2"/>

  <!-- Floor Beams / Girders -->
  <line class="illo-line" x1="38" y1="74" x2="242" y2="74" stroke="<%= accent %>" stroke-width="1.8"/>
  <line class="illo-line" x1="38" y1="48" x2="242" y2="48" stroke="<%= accent %>" stroke-width="1.8"/>
  <line class="illo-line" x1="38" y1="22" x2="242" y2="22" stroke="<%= accent %>" stroke-width="2"/>

  <!-- Warren Truss Cross-Braces (Bay 1 & Bay 2) -->
  <line class="illo-line" x1="38" y1="74" x2="89" y2="48" stroke="<%= accent %>" stroke-width="0.9" opacity="0.6"/>
  <line class="illo-line" x1="89" y1="48" x2="140" y2="74" stroke="<%= accent %>" stroke-width="0.9" opacity="0.6"/>
  <line class="illo-line" x1="89" y1="22" x2="38" y2="48" stroke="<%= accent %>" stroke-width="0.9" opacity="0.6"/>
  <line class="illo-line" x1="89" y1="22" x2="140" y2="48" stroke="<%= accent %>" stroke-width="0.9" opacity="0.6"/>

  <line class="illo-line" x1="140" y1="74" x2="191" y2="48" stroke="<%= accent %>" stroke-width="0.9" opacity="0.6"/>
  <line class="illo-line" x1="191" y1="48" x2="242" y2="74" stroke="<%= accent %>" stroke-width="0.9" opacity="0.6"/>
  <line class="illo-line" x1="191" y1="22" x2="140" y2="48" stroke="<%= accent %>" stroke-width="0.9" opacity="0.6"/>
  <line class="illo-line" x1="191" y1="22" x2="242" y2="48" stroke="<%= accent %>" stroke-width="0.9" opacity="0.6"/>

  <!-- Structural Joint Nodes & Gusset Plates -->
  <% [38, 140, 242].forEach(function(cx) { %>
    <circle cx="<%= cx %>" cy="22" r="3" fill="#FFFDF9" stroke="<%= accent %>" stroke-width="1.2"/>
    <circle cx="<%= cx %>" cy="48" r="3" fill="#FFFDF9" stroke="<%= accent %>" stroke-width="1.2"/>
    <circle cx="<%= cx %>" cy="74" r="3" fill="#FFFDF9" stroke="<%= accent %>" stroke-width="1.2"/>
  <% }); %>

  <!-- Health Monitoring / NDT Telemetry Sensor (Bay Center) -->
  <circle cx="140" cy="48" r="7" fill="none" stroke="#C49A2C" stroke-width="1" stroke-dasharray="3 2"/>
  <circle cx="140" cy="48" r="1.8" fill="#C49A2C"/>
  <path d="M140 37 Q146 41 146 48 Q146 55 140 59" fill="none" stroke="#C49A2C" stroke-width="0.8" opacity="0.75"/>

  <!-- Architectural Dimension Annotation Lines -->
  <line x1="256" y1="22" x2="256" y2="108" stroke="<%= accent %>" stroke-width="0.7" opacity="0.4"/>
  <line x1="252" y1="22" x2="260" y2="22" stroke="<%= accent %>" stroke-width="0.8" opacity="0.6"/>
  <line x1="252" y1="108" x2="260" y2="108" stroke="<%= accent %>" stroke-width="0.8" opacity="0.6"/>
  <text x="264" y="68" font-family="'Marcellus', serif" font-size="7.5" fill="<%= accent %>" opacity="0.8" transform="rotate(90 264 68)">H=18.5M</text>

  <!-- Fine drafting border with corner registration marks -->
  <rect x="2" y="2" width="276" height="116" rx="2" fill="none" stroke="rgba(196,154,44,0.3)" stroke-width="0.75"/>
  <line x1="2" y1="8" x2="8" y2="8" stroke="#C49A2C" stroke-width="0.8"/>
  <line x1="8" y1="2" x2="8" y2="8" stroke="#C49A2C" stroke-width="0.8"/>
  <line x1="272" y1="8" x2="278" y2="8" stroke="#C49A2C" stroke-width="0.8"/>
  <line x1="272" y1="2" x2="272" y2="8" stroke="#C49A2C" stroke-width="0.8"/>
</svg>

<% } else if (illoId === 'illo-water') { %>
<%# ── Track 02 · Water Resources & Hydraulic Systems ── %>
<svg class="atlas-illo-svg" viewBox="0 0 280 120" xmlns="http://www.w3.org/2000/svg"
     role="img" aria-label="Hydraulic dam and water flow engineering cross section">
  <defs>
    <pattern id="wave-pat" width="16" height="8" patternUnits="userSpaceOnUse">
      <path d="M0 4 Q4 0 8 4 Q12 8 16 4" fill="none" stroke="<%= accent %>" stroke-width="0.8" opacity="0.45"/>
    </pattern>
  </defs>
  <!-- Reservoir Upstream Basin -->
  <rect class="illo-path" x="8" y="28" width="86" height="80" rx="1" fill="url(#wave-pat)" stroke="<%= accent %>" stroke-width="0.8" opacity="0.7"/>

  <!-- Concrete Gravity Dam Body (Ogee Crest Profile) -->
  <path class="illo-path" d="M94 26 L112 26 Q120 26 124 34 Q132 50 148 88 L152 108 L94 108 Z" fill="<%= accent %>" opacity="0.18" stroke="<%= accent %>" stroke-width="1.4"/>
  <path class="illo-path" d="M112 26 Q120 26 124 34 Q132 50 148 88 L152 108" fill="none" stroke="<%= accent %>" stroke-width="1.6"/>

  <!-- Hydrostatic Pressure Triangle Vectors -->
  <line class="illo-line" x1="94" y1="26" x2="94" y2="108" stroke="<%= accent %>" stroke-width="1.4"/>
  <% [42, 58, 74, 90, 104].forEach(function(py) {
       var len = ((py - 26) / 82) * 28;
  %>
    <line class="illo-line" x1="<%= 94 - len %>" y1="<%= py %>" x2="94" y2="<%= py %>" stroke="#C49A2C" stroke-width="0.8" opacity="0.8"/>
    <polygon points="<%= 94 %>,<%= py %> <%= 90 %>,<%= py-2.5 %> <%= 90 %>,<%= py+2.5 %>" fill="#C49A2C" opacity="0.8"/>
  <% }); %>
  <line class="illo-line" x1="66" y1="104" x2="94" y2="26" stroke="#C49A2C" stroke-width="0.8" stroke-dasharray="3 3" opacity="0.7"/>

  <!-- Water Surface & Freeboard Datums -->
  <line class="illo-line" x1="8" y1="34" x2="94" y2="34" stroke="#C49A2C" stroke-width="1" stroke-dasharray="4 3"/>
  <text x="12" y="30" font-family="'Marcellus', serif" font-size="7" fill="#C49A2C" letter-spacing="1">▼ FRL EL. +340.0M</text>

  <!-- Downstream Hydraulic Jump & Water Flow Lines -->
  <path class="illo-path" d="M124 34 Q136 60 152 92 Q164 104 186 98 Q208 92 235 98 L272 98" fill="none" stroke="<%= accent %>" stroke-width="1.8" opacity="0.85"/>
  <path class="illo-path" d="M152 98 Q170 110 192 104 Q214 98 240 104 L272 104" fill="none" stroke="<%= accent %>" stroke-width="1" opacity="0.5"/>
  <path class="illo-path" d="M180 88 Q188 82 196 88 Q204 94 212 88" fill="none" stroke="<%= accent %>" stroke-width="0.75" opacity="0.4"/>

  <!-- Dam Scour Key / Foundation Cutoff Wall -->
  <rect class="illo-path" x="98" y="108" width="16" height="8" fill="<%= accent %>" opacity="0.3"/>
  <line x1="8" y1="108" x2="272" y2="108" stroke="<%= accent %>" stroke-width="1.2"/>

  <!-- Elevation Ruler Ticks on Dam Face -->
  <% [40, 56, 72, 88].forEach(function(ty) { %>
    <line x1="90" y1="<%= ty %>" x2="98" y2="<%= ty %>" stroke="<%= accent %>" stroke-width="0.75" opacity="0.5"/>
  <% }); %>

  <!-- Fine drafting border with corner ticks -->
  <rect x="2" y="2" width="276" height="116" rx="2" fill="none" stroke="rgba(196,154,44,0.3)" stroke-width="0.75"/>
</svg>

<% } else if (illoId === 'illo-environmental') { %>
<%# ── Track 03 · Environmental Engineering & Circular Economy ── %>
<svg class="atlas-illo-svg" viewBox="0 0 280 120" xmlns="http://www.w3.org/2000/svg"
     role="img" aria-label="Environmental circular reclamation plant engineering layout">
  <!-- Inflow Conduit -->
  <line class="illo-line" x1="10" y1="60" x2="48" y2="60" stroke="<%= accent %>" stroke-width="2.2"/>
  <polygon points="46,56 54,60 46,64" fill="<%= accent %>"/>
  <text x="12" y="52" font-family="'Marcellus', serif" font-size="7" fill="<%= accent %>" letter-spacing="1">RAW INFLOW</text>

  <!-- Circular Primary Clarifier Tank -->
  <circle class="illo-path" cx="80" cy="60" r="30" fill="<%= accent %>" opacity="0.08" stroke="<%= accent %>" stroke-width="1.4"/>
  <circle class="illo-path" cx="80" cy="60" r="20" fill="none" stroke="<%= accent %>" stroke-width="0.7" stroke-dasharray="3 3"/>
  <circle cx="80" cy="60" r="4" fill="<%= accent %>" opacity="0.6"/>
  <line class="illo-line" x1="50" y1="60" x2="110" y2="60" stroke="<%= accent %>" stroke-width="0.8" opacity="0.4"/>
  <line class="illo-line" x1="80" y1="30" x2="80" y2="90" stroke="<%= accent %>" stroke-width="0.8" opacity="0.4"/>

  <!-- Intermediate Flow Channel -->
  <line class="illo-line" x1="110" y1="60" x2="148" y2="60" stroke="<%= accent %>" stroke-width="1.8"/>

  <!-- Rectangular Aeration Basin with Biofiltration Grid -->
  <rect class="illo-path" x="148" y="38" width="60" height="44" rx="2" fill="<%= accent %>" opacity="0.08" stroke="<%= accent %>" stroke-width="1.2"/>
  <% [46, 54, 62, 70].forEach(function(gy) { %>
    <line x1="150" y1="<%= gy %>" x2="206" y2="<%= gy %>" stroke="<%= accent %>" stroke-width="0.6" opacity="0.3"/>
  <% }); %>
  <% [160, 172, 184, 196].forEach(function(gx) { %>
    <line x1="<%= gx %>" y1="40" x2="<%= gx %>" y2="80" stroke="<%= accent %>" stroke-width="0.6" opacity="0.3"/>
  <% }); %>
  <circle cx="178" cy="60" r="2.5" fill="#C49A2C"/>

  <!-- Secondary Clarifier / Disinfection Vessel -->
  <line class="illo-line" x1="208" y1="60" x2="226" y2="60" stroke="<%= accent %>" stroke-width="1.8"/>
  <circle class="illo-path" cx="248" cy="60" r="22" fill="<%= accent %>" opacity="0.08" stroke="<%= accent %>" stroke-width="1.4"/>
  <circle class="illo-path" cx="248" cy="60" r="14" fill="none" stroke="<%= accent %>" stroke-width="0.7" stroke-dasharray="2.5 2.5"/>
  <circle cx="248" cy="60" r="3.5" fill="<%= accent %>" opacity="0.5"/>

  <!-- Outflow Conduit -->
  <line class="illo-line" x1="270" y1="60" x2="276" y2="60" stroke="<%= accent %>" stroke-width="2"/>

  <!-- Circular Economy Closed-Loop Recycle Arc (Sludge / Resource Valorization) -->
  <path class="illo-path" d="M248 82 Q230 106 178 108 Q120 110 80 90" fill="none" stroke="#C49A2C" stroke-width="1.2" stroke-dasharray="4 3"/>
  <polygon points="80,90 84,95 86,88" fill="#C49A2C"/>
  <text x="178" y="115" text-anchor="middle" font-family="'Marcellus', serif" font-size="7" fill="#C49A2C" letter-spacing="1.2">CIRCULAR VALORIZATION LOOP</text>

  <!-- Fine drafting border -->
  <rect x="2" y="2" width="276" height="116" rx="2" fill="none" stroke="rgba(196,154,44,0.3)" stroke-width="0.75"/>
</svg>

<% } else if (illoId === 'illo-geotechnical') { %>
<%# ── Track 04 · Geotechnical Engineering & Ground Improvement ── %>
<svg class="atlas-illo-svg" viewBox="0 0 280 120" xmlns="http://www.w3.org/2000/svg"
     role="img" aria-label="Geotechnical stratigraphic borehole and deep foundation log">
  <defs>
    <pattern id="pat-gravel" width="8" height="8" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1.4" fill="<%= accent %>" opacity="0.35"/>
      <circle cx="6" cy="6" r="1.4" fill="<%= accent %>" opacity="0.3"/>
    </pattern>
    <pattern id="pat-sand" width="6" height="6" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="0.8" fill="<%= accent %>" opacity="0.45"/>
    </pattern>
    <pattern id="pat-clay" width="10" height="4" patternUnits="userSpaceOnUse">
      <line x1="0" y1="2" x2="10" y2="2" stroke="<%= accent %>" stroke-width="0.7" opacity="0.5"/>
    </pattern>
    <pattern id="pat-rock" width="8" height="8" patternUnits="userSpaceOnUse">
      <path d="M0 4 L4 0 L8 4 L4 8 Z" fill="none" stroke="<%= accent %>" stroke-width="0.6" opacity="0.4"/>
    </pattern>
  </defs>

  <!-- Ground Surface Elevation Line -->
  <line class="illo-line" x1="16" y1="12" x2="264" y2="12" stroke="<%= accent %>" stroke-width="1.8"/>
  <text x="20" y="8" font-family="'Marcellus', serif" font-size="7" fill="<%= accent %>" letter-spacing="1">GROUND SURFACE GL ±0.00M</text>

  <!-- Central Stratigraphic Borehole Log Column -->
  <rect class="illo-path" x="48" y="12" width="28" height="24" fill="url(#pat-gravel)" stroke="<%= accent %>" stroke-width="1"/>
  <rect class="illo-path" x="48" y="36" width="28" height="28" fill="url(#pat-sand)" stroke="<%= accent %>" stroke-width="1"/>
  <rect class="illo-path" x="48" y="64" width="28" height="26" fill="url(#pat-clay)" stroke="<%= accent %>" stroke-width="1"/>
  <rect class="illo-path" x="48" y="90" width="28" height="24" fill="url(#pat-rock)" stroke="<%= accent %>" stroke-width="1"/>

  <!-- Layer Labels -->
  <text x="82" y="26" font-family="'Marcellus', serif" font-size="7" fill="<%= accent %>" opacity="0.85">FILL / GRAVEL</text>
  <text x="82" y="52" font-family="'Marcellus', serif" font-size="7" fill="<%= accent %>" opacity="0.85">SILTY SAND</text>
  <text x="82" y="78" font-family="'Marcellus', serif" font-size="7" fill="<%= accent %>" opacity="0.85">STIFF CLAY</text>
  <text x="82" y="104" font-family="'Marcellus', serif" font-size="7" fill="<%= accent %>" opacity="0.85">BEDROCK</text>

  <!-- Depth Scale Ticks -->
  <line x1="38" y1="12" x2="38" y2="114" stroke="<%= accent %>" stroke-width="0.8" opacity="0.5"/>
  <% [12, 36, 64, 90, 114].forEach(function(dy) { %>
    <line x1="33" y1="<%= dy %>" x2="43" y2="<%= dy %>" stroke="<%= accent %>" stroke-width="1"/>
  <% }); %>

  <!-- SPT N-Value Resistance Resistance Graph (N=0 to 50 blows/ft) -->
  <line x1="160" y1="12" x2="160" y2="114" stroke="<%= accent %>" stroke-width="0.8" opacity="0.4"/>
  <polyline class="illo-path"
    points="165,16 174,28 170,42 186,56 178,68 198,82 192,94 214,106"
    fill="none" stroke="#C49A2C" stroke-width="1.4" stroke-linejoin="round"/>
  <% [[165,16],[174,28],[170,42],[186,56],[178,68],[198,82],[192,94],[214,106]].forEach(function(pt) { %>
    <circle cx="<%= pt[0] %>" cy="<%= pt[1] %>" r="2.2" fill="#C49A2C"/>
  <% }); %>
  <text x="160" y="8" font-family="'Marcellus', serif" font-size="6.5" fill="#C49A2C" letter-spacing="1">SPT N-VALUE</text>

  <!-- Deep Foundation Pile (Right Bay) -->
  <rect class="illo-path" x="238" y="10" width="18" height="8" fill="<%= accent %>" opacity="0.4" stroke="<%= accent %>" stroke-width="1"/>
  <rect class="illo-path" x="242" y="18" width="10" height="92" fill="<%= accent %>" opacity="0.15" stroke="<%= accent %>" stroke-width="1.1"/>
  <line x1="242" y1="90" x2="252" y2="90" stroke="#C49A2C" stroke-width="1" stroke-dasharray="2 2"/>
  <text x="247" y="117" text-anchor="middle" font-family="'Marcellus', serif" font-size="6.5" fill="<%= accent %>">SOCKET</text>

  <!-- Fine drafting border -->
  <rect x="2" y="2" width="276" height="116" rx="2" fill="none" stroke="rgba(196,154,44,0.3)" stroke-width="0.75"/>
</svg>

<% } else if (illoId === 'illo-ai') { %>
<%# ── Track 05 · AI & Computational Civil Engineering ── %>
<svg class="atlas-illo-svg" viewBox="0 0 280 120" xmlns="http://www.w3.org/2000/svg"
     role="img" aria-label="Digital twin neural network telemetry mesh for infrastructure">
  <defs>
    <radialGradient id="node-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="<%= accent %>" stop-opacity="0.45"/>
      <stop offset="100%" stop-color="<%= accent %>" stop-opacity="0.02"/>
    </radialGradient>
  </defs>

  <!-- Background Spatial GIS Grid Lines -->
  <% for(var gx=10; gx<280; gx+=24){ %>
    <line x1="<%= gx %>" y1="0" x2="<%= gx %>" y2="120" stroke="<%= accent %>" stroke-width="0.3" opacity="0.12"/>
  <% } %>
  <% for(var gy=10; gy<120; gy+=22){ %>
    <line x1="0" y1="<%= gy %>" x2="280" y2="<%= gy %>" stroke="<%= accent %>" stroke-width="0.3" opacity="0.12"/>
  <% } %>

  <!-- Infrastructure Telemetry Graph Mesh Nodes -->
  <%
    var aiNodes = [
      [36, 30], [100, 20], [170, 24], [240, 32],
      [68, 64], [140, 58], [212, 66],
      [38, 98], [108, 96], [182, 100], [248, 94]
    ];
    var aiEdges = [
      [0,1],[1,2],[2,3],
      [0,4],[1,4],[1,5],[2,5],[2,6],[3,6],
      [4,7],[4,8],[5,8],[5,9],[6,9],[6,10],
      [7,8],[8,9],[9,10]
    ];
  %>

  <!-- Graph Connection Vectors (Edges) -->
  <% aiEdges.forEach(function(e) { %>
    <line class="illo-line"
      x1="<%= aiNodes[e[0]][0] %>" y1="<%= aiNodes[e[0]][1] %>"
      x2="<%= aiNodes[e[1]][0] %>" y2="<%= aiNodes[e[1]][1] %>"
      stroke="<%= accent %>" stroke-width="0.85" opacity="0.35"/>
  <% }); %>

  <!-- Node Halos & Pulse Rings -->
  <% aiNodes.forEach(function(n, i) { %>
    <circle cx="<%= n[0] %>" cy="<%= n[1] %>" r="7" fill="url(#node-glow)"/>
  <% }); %>

  <!-- Central Digital Twin Gateway Pulse -->
  <circle cx="140" cy="58" r="14" fill="none" stroke="#C49A2C" stroke-width="0.9" stroke-dasharray="3 3" opacity="0.75"/>
  <circle cx="140" cy="58" r="22" fill="none" stroke="#C49A2C" stroke-width="0.5" stroke-dasharray="4 4" opacity="0.4"/>

  <!-- Node Vertex Dots -->
  <% aiNodes.forEach(function(n, i) {
       var isCentral = (i === 5 || i === 1 || i === 8);
  %>
    <circle class="illo-path" cx="<%= n[0] %>" cy="<%= n[1] %>" r="<%= isCentral ? 4 : 2.8 %>"
      fill="<%= isCentral ? '#C49A2C' : accent %>" opacity="<%= isCentral ? 0.95 : 0.7 %>"/>
  <% }); %>

  <!-- Computational Lifecycle Telemetry Bar -->
  <line x1="16" y1="112" x2="264" y2="112" stroke="<%= accent %>" stroke-width="0.8" opacity="0.3"/>
  <rect class="illo-path" x="16" y="110" width="70" height="4" rx="1" fill="<%= accent %>" opacity="0.7"/>
  <rect class="illo-path" x="90" y="110" width="45" height="4" rx="1" fill="#C49A2C" opacity="0.8"/>
  <rect class="illo-path" x="139" y="110" width="55" height="4" rx="1" fill="<%= accent %>" opacity="0.4"/>
  <text x="200" y="114" font-family="'Marcellus', serif" font-size="6.5" fill="<%= accent %>" opacity="0.8">DIGITAL TWIN · REALTIME</text>

  <!-- Fine drafting border -->
  <rect x="2" y="2" width="276" height="116" rx="2" fill="none" stroke="rgba(196,154,44,0.3)" stroke-width="0.75"/>
</svg>

<% } else if (illoId === 'illo-transport') { %>
<%# ── Track 06 · Transportation Engineering & Urban Mobility ── %>
<svg class="atlas-illo-svg" viewBox="0 0 280 120" xmlns="http://www.w3.org/2000/svg"
     role="img" aria-label="Highway interchange geometry and smart transportation corridor">
  <!-- Horizontal Highway Corridor -->
  <rect class="illo-path" x="10" y="52" width="260" height="16" rx="2" fill="<%= accent %>" opacity="0.10" stroke="<%= accent %>" stroke-width="1.2"/>
  <% for(var dx=16; dx<264; dx+=18){ %>
    <line x1="<%= dx %>" y1="60" x2="<%= dx+10 %>" y2="60" stroke="#C49A2C" stroke-width="0.85" opacity="0.7"/>
  <% } %>

  <!-- Cloverleaf Connector Ramps (Curved Geometry) -->
  <path class="illo-path" d="M50 52 Q50 18 95 14 Q130 10 155 12" fill="none" stroke="<%= accent %>" stroke-width="1.4"/>
  <path class="illo-path" d="M58 52 Q58 24 99 20 Q132 16 157 18" fill="none" stroke="<%= accent %>" stroke-width="0.7" opacity="0.4"/>

  <path class="illo-path" d="M75 68 Q75 100 118 106 Q146 110 170 108" fill="none" stroke="<%= accent %>" stroke-width="1.4"/>
  <path class="illo-path" d="M83 68 Q83 94 122 100 Q148 104 172 102" fill="none" stroke="<%= accent %>" stroke-width="0.7" opacity="0.4"/>

  <path class="illo-path" d="M205 52 Q218 26 242 16 Q260 12 270 12" fill="none" stroke="<%= accent %>" stroke-width="1.4"/>
  <path class="illo-path" d="M210 68 Q222 96 248 106 Q262 110 270 108" fill="none" stroke="<%= accent %>" stroke-width="1.4"/>

  <!-- Signalized Corridor Nodes -->
  <circle class="illo-path" cx="78" cy="60" r="7.5" fill="#FFFDF9" stroke="<%= accent %>" stroke-width="1.2"/>
  <circle cx="78" cy="60" r="3.2" fill="<%= accent %>" opacity="0.5"/>

  <circle class="illo-path" cx="206" cy="60" r="7.5" fill="#FFFDF9" stroke="<%= accent %>" stroke-width="1.2"/>
  <circle cx="206" cy="60" r="3.2" fill="<%= accent %>" opacity="0.5"/>

  <!-- Smart City Hexagonal Grid Cells (Top Right Corridor) -->
  <%
    var hexData = [
      { cx:235, cy:26 },
      { cx:248, cy:26 },
      { cx:241, cy:38 }
    ];
    hexData.forEach(function(h) {
      var pts = [
        h.cx + ',' + (h.cy+6),
        (h.cx+5) + ',' + (h.cy+3),
        (h.cx+5) + ',' + (h.cy-3),
        h.cx + ',' + (h.cy-6),
        (h.cx-5) + ',' + (h.cy-3),
        (h.cx-5) + ',' + (h.cy+3)
      ].join(' ');
  %>
    <polygon class="illo-path"
      points="<%= pts %>"
      fill="<%= accent %>" opacity="0.09" stroke="<%= accent %>" stroke-width="0.7"/>
  <% }); %>

  <!-- Pavement Layer Structure Callout (Top Left) -->
  <rect class="illo-path" x="12" y="6" width="34" height="34" rx="1" fill="none" stroke="<%= accent %>" stroke-width="0.7" opacity="0.45"/>
  <rect x="14" y="8"  width="30" height="6" fill="<%= accent %>" opacity="0.30"/>
  <rect x="14" y="15" width="30" height="6" fill="<%= accent %>" opacity="0.20"/>
  <rect x="14" y="22" width="30" height="8" fill="<%= accent %>" opacity="0.12"/>
  <rect x="14" y="31" width="30" height="7" fill="<%= accent %>" opacity="0.07"/>
  <text x="12" y="46" font-family="'Marcellus', serif" font-size="6" fill="<%= accent %>" opacity="0.8">PAVEMENT</text>

  <!-- Flow Direction Triangles -->
  <polygon points="134,57 140,60 134,63" fill="#C49A2C"/>
  <polygon points="144,63 138,60 144,57" fill="#C49A2C"/>

  <!-- Fine drafting border -->
  <rect x="2" y="2" width="276" height="116" rx="2" fill="none" stroke="rgba(196,154,44,0.3)" stroke-width="0.75"/>
</svg>
<% } %>
