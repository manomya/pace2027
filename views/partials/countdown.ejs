<!-- Flip Clock JavaScript Controller -->
<script>
  (function () {
    // Conference Target Date: 29 January 2027 09:00:00 IST (UTC+05:30)
    const targetDate = new Date('2027-01-29T09:00:00+05:30').getTime();

    // Mapping of individual tile IDs
    const tileIds = ['d100', 'd10', 'd1', 'h10', 'h1', 'm10', 'm1', 's10', 's1'];

    function flipTile(id, nextVal) {
      const tile = document.getElementById('tile-' + id);
      if (!tile) return;
      const currentVal = tile.getAttribute('data-value') || '0';
      if (currentVal === String(nextVal)) return;

      const nextTop = tile.querySelector('.next-top .digit');
      const currentBottom = tile.querySelector('.current-bottom .digit');
      const currentTop = tile.querySelector('.current-top .digit');
      const nextBottom = tile.querySelector('.next-bottom .digit');

      // Set digits for animation transition
      if (nextTop) nextTop.textContent = nextVal;
      if (currentBottom) currentBottom.textContent = currentVal;
      if (currentTop) currentTop.textContent = currentVal;
      if (nextBottom) nextBottom.textContent = nextVal;

      // Trigger 3D flap rotation
      tile.classList.remove('flipping');
      void tile.offsetWidth; // Force reflow
      tile.classList.add('flipping');

      // Update stored value
      tile.setAttribute('data-value', String(nextVal));

      setTimeout(function () {
        if (currentBottom) currentBottom.textContent = nextVal;
        if (currentTop) currentTop.textContent = nextVal;
        tile.classList.remove('flipping');
      }, 580);
    }

    function updateCountdown(isInitial) {
      const now = Date.now();
      let diff = Math.max(0, targetDate - now);

      const totalSeconds = Math.floor(diff / 1000);
      const days = Math.floor(totalSeconds / (3600 * 24));
      const hours = Math.floor((totalSeconds % (3600 * 24)) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      const daysStr = String(Math.min(999, days)).padStart(3, '0');
      const hoursStr = String(hours).padStart(2, '0');
      const minutesStr = String(minutes).padStart(2, '0');
      const secondsStr = String(seconds).padStart(2, '0');

      const values = {
        'd100': daysStr[0],
        'd10': daysStr[1],
        'd1': daysStr[2],
        'h10': hoursStr[0],
        'h1': hoursStr[1],
        'm10': minutesStr[0],
        'm1': minutesStr[1],
        's10': secondsStr[0],
        's1': secondsStr[1]
      };

      tileIds.forEach(function (id) {
        if (isInitial) {
          const tile = document.getElementById('tile-' + id);
          if (tile) {
            tile.setAttribute('data-value', values[id]);
            const digits = tile.querySelectorAll('.digit');
            digits.forEach(function(el) { el.textContent = values[id]; });
          }
        } else {
          flipTile(id, values[id]);
        }
      });
    }

    // Initialize with current difference
    updateCountdown(true);

    // Refresh every second
    setInterval(function () {
      updateCountdown(false);
    }, 1000);
  })();
</script>
