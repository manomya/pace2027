<section class="hero-architectural-main w-full relative min-h-[720px] lg:min-h-[820px] bg-[#f6efe5] overflow-hidden flex items-stretch">
  <!-- Right Graphic Layer: High fidelity architectural illustration from reference image -->
  <div class="absolute inset-0 z-0 pointer-events-none select-none overflow-hidden">
    <!-- Image positioned to cover background seamlessly matching the warm parchment tone -->
    <img alt="Architectural Blueprint Drawing of Cable Stayed Bridge Elevation" class="w-full h-full object-cover object-center lg:object-right opacity-100" src="/images/hero-cable-stayed-bridge.png?v=2027.6" />
    <!-- Subtle smooth left scrim to guarantee interactive HTML text contrast and accessibility across all screen sizes -->
    <div class="absolute inset-y-0 left-0 w-full sm:w-[60%] md:w-[52%] lg:w-[48%] bg-gradient-to-r from-[#f6efe5] via-[#f6efe5]/90 to-transparent"></div>
  </div>
  <!-- Interactive Foreground Content -->
  <div class="relative z-10 w-full max-w-[1920px] mx-auto px-6 sm:px-12 md:px-16 lg:px-20 xl:px-24 py-10 lg:py-14 flex flex-col justify-between">
    <!-- Top & Middle Content Column -->
    <div class="max-w-xl lg:max-w-2xl xl:max-w-[650px] pt-2">
      <!-- Eyebrow Category -->
      <div class="flex items-center gap-4 mb-3 sm:mb-4">
        <span class="text-[12px] sm:text-[13px] tracking-[0.25em] uppercase font-serif font-semibold text-[#4b1720]">
          International Conference On
        </span>
        <div class="h-[1px] w-12 bg-[#4b1720]/40 hidden sm:block"></div>
      </div>
      <!-- Main Title -->
      <h1 class="font-serif leading-[1.03] tracking-tight">
        <span class="block text-5xl sm:text-6xl lg:text-[68px] xl:text-[76px] font-bold text-[#4b1720]">
          Pioneering
        </span>
        <span class="block text-5xl sm:text-6xl lg:text-[68px] xl:text-[76px] font-bold text-[#4b1720] mt-0.5">
          Advancements in
        </span>
        <span class="block text-5xl sm:text-6xl lg:text-[68px] xl:text-[76px] font-semibold text-[#c88a24] mt-1">
          Civil Engineering
        </span>
      </h1>
      <!-- Acronym & Year -->
      <div class="mt-4 sm:mt-5 text-[#4b1720] font-serif text-xl sm:text-2xl lg:text-[25px] tracking-[0.38em] font-semibold uppercase">
        P A C E &nbsp;—&nbsp; 2 0 2 7
      </div>
      <!-- Thin Horizontal Divider Line -->
      <div class="w-full max-w-[480px] h-[1px] bg-[#cdbaa8] my-4 sm:my-5"></div>
      <!-- Body Narrative -->
      <p class="font-body text-[16px] sm:text-[17.5px] leading-relaxed text-[#3d231e] max-w-[550px]">
        Bringing together scientists, technocrats, scholars and young researchers to present the latest advancements across all domains of civil engineering — in the Pink City of Jaipur.
      </p>
      <!-- CTA Action Buttons -->
      <div class="mt-7 sm:mt-8 flex flex-wrap items-center gap-4">
        <!-- Register Now Button -->
        <a class="inline-flex items-center justify-center gap-2.5 px-7 py-3 rounded-[3px] bg-[#c88a24] hover:bg-[#b3791b] text-white font-serif font-bold text-[16.5px] tracking-wide shadow-sm transition-colors duration-150 group" href="/registration">
          <span>Register Now</span>
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <!-- Submit Paper Button -->
        <a class="inline-flex items-center justify-center gap-2.5 px-7 py-3 rounded-[3px] border border-[#4b1720] bg-transparent hover:bg-[#ede3d2] text-[#4b1720] font-serif font-semibold text-[16.5px] tracking-wide transition-colors duration-150 group" href="/papers">
          <span>Submit a Paper</span>
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
    <!-- Bottom Metadata Bar -->
    <div class="mt-12 sm:mt-16 pt-2">
      <div class="inline-flex flex-wrap items-center gap-y-4 gap-x-6 sm:gap-x-8 text-[#3d231e]">
        <!-- Column 1: Dates -->
        <div class="flex items-center gap-3">
          <div class="text-[#c88a24] flex-shrink-0">
            <!-- Calendar Icon -->
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24">
              <rect height="18" rx="2" ry="2" width="18" x="3" y="4"></rect>
              <line x1="16" x2="16" y1="2" y2="6"></line>
              <line x1="8" x2="8" y1="2" y2="6"></line>
              <line x1="3" x2="21" y1="10" y2="10"></line>
              <circle cx="8" cy="14" fill="currentColor" r="1"></circle>
              <circle cx="12" cy="14" fill="currentColor" r="1"></circle>
              <circle cx="16" cy="14" fill="currentColor" r="1"></circle>
              <circle cx="8" cy="18" fill="currentColor" r="1"></circle>
              <circle cx="12" cy="18" fill="currentColor" r="1"></circle>
              <circle cx="16" cy="18" fill="currentColor" r="1"></circle>
            </svg>
          </div>
          <div class="font-serif leading-tight">
            <span class="block text-[14.5px] font-bold text-[#3d231e] tracking-wider">29 – 30</span>
            <span class="text-[12px] uppercase tracking-widest text-[#5d3b32] font-semibold">JANUARY 2027</span>
          </div>
        </div>
        <!-- Vertical Divider -->
        <div class="hidden sm:block h-8 w-[1px] bg-[#cdbaa8]"></div>
        <!-- Column 2: Venue -->
        <div class="flex items-center gap-3">
          <div class="text-[#c88a24] flex-shrink-0">
            <!-- Location Pin Icon -->
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div class="font-serif leading-tight">
            <span class="block text-[13px] font-bold tracking-widest uppercase text-[#3d231e]">POORNIMA UNIVERSITY,</span>
            <span class="text-[12px] tracking-widest uppercase text-[#5d3b32] font-semibold">JAIPUR</span>
          </div>
        </div>
        <!-- Vertical Divider -->
        <div class="hidden sm:block h-8 w-[1px] bg-[#cdbaa8]"></div>
        <!-- Column 3: Proceedings -->
        <div class="flex items-center gap-3">
          <div class="text-[#c88a24] flex-shrink-0">
            <!-- Open Book Icon -->
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              <line x1="12" x2="16" y1="6" y2="6"></line>
              <line x1="12" x2="16" y1="10" y2="10"></line>
            </svg>
          </div>
          <div class="font-serif leading-tight">
            <span class="block text-[13px] font-bold tracking-widest uppercase text-[#3d231e]">PROCEEDINGS</span>
            <span class="text-[12px] tracking-widest uppercase text-[#5d3b32] font-semibold">WITH ISBN</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/countdown') %>

<section><div class="wrap">
  <div class="eyebrow">About the Conference</div>
  <h2>PACE – 2027</h2>
  <p class="lead">The PACE-2027 conference aims to bring together scientists, technocrats, scholars, and young researchers to present the latest advancements across all domains of civil engineering. The conference emphasizes sustainability, resilience, and data-driven solutions. It fosters collaboration, knowledge exchange, and innovation for next-generation infrastructure systems.</p>
  <p style="margin-top:18px"><a class="btn btn-gold" href="/about">Read More</a></p>
</div></section>

<%- include('../partials/key-deadlines') %>

<section class="cream"><div class="wrap">
  <div class="eyebrow">Conference Themes</div>
  <h2>Six Technical Tracks</h2>
  <p class="lead">The conference welcomes high-quality original research across civil engineering and allied disciplines. The listed tracks are indicative and not exhaustive; innovative and interdisciplinary research is also encouraged.</p>
  <div class="tracks">
    <% themes.forEach(function(t) { %>
      <div class="track">
        <div>
          <span class="t-no"><%= t.track %></span>
          <span class="t-name"><%= t.title %></span>
        </div>
        <ul>
          <% t.topics.forEach(function(s) { %>
            <li><%= s %></li>
          <% }); %>
        </ul>
      </div>
    <% }); %>
  </div>
</div></section>

<section class="brick-reveal-section" id="partners-section"><div class="wrap">
  <%- include('../partials/brick-wall-partners') %>
</div></section>
